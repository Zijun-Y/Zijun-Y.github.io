---
import "../styles/global.css";
import { getImage } from "astro:assets";
import NetworkCanvas from "@/components/NetworkCanvas.svelte";
import ContactPanel from "@/components/ContactPanel.svelte";
import portraitSrc from "@/assets/portrait.jpg";
const { title = "Zijun Yu — PhD, McGill" } = Astro.props;

const portrait = await getImage({
    src: portraitSrc,
    width: 640,
    height: 768,
    format: "webp",
});
const portrait2x = await getImage({
    src: portraitSrc,
    width: 1280,
    height: 1536,
    format: "webp",
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <title>{title}</title>
        <meta
            name="description"
            content="Zijun Yu — PhD student in Mathematics & Statistics at McGill University. Conformal prediction, survival analysis, deep learning."
        />

        <!--
          Fonts: self-hosted from /fonts (see @font-face rules in
          global.css) — no request to Google's font CDN, so first paint
          isn't blocked on it and the page still loads fonts in regions
          where Google is unreachable. Preload only the above-the-fold
          latin subsets; italic/latin-ext load lazily as needed.
        -->
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="preload"
            href="/fonts/petrona-normal-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/geist-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/geist-mono-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>

    <body>
        <!-- Fixed canvas background — starts blank, grows on hover -->
        <NetworkCanvas client:visible />

        <slot />

        <!-- Contact panel — global, opened by 'open-contact' window event -->
        <ContactPanel
            client:visible
            portraitSrc={portrait.src}
            portraitSrcSet={`${portrait.src} 1x, ${portrait2x.src} 2x`}
        />

        <!--
      SEO crawl anchors — visually hidden, rendered server-side without JS.
      ContactPanel is JS-hydrated; these ensure profile links are always in HTML for crawlers.
    -->
        <div class="zh-seo-links" aria-hidden="true">
            <a href="https://github.com/Zijun-Y" rel="noopener noreferrer"
                >GitHub: Zijun-Y</a
            >
            <a
                href="https://www.linkedin.com/in/yuzijun"
                rel="noopener noreferrer">LinkedIn: yuzijun</a
            >
            <a
                href="https://openreview.net/profile?id=~Zijun_Yu2"
                rel="noopener noreferrer">OpenReview: Zijun_Yu2</a
            >
            <a
                href="https://orcid.org/0009-0001-1989-1304"
                rel="noopener noreferrer">ORCID: 0009-0001-1989-1304</a
            >
            <a
                href="https://scholar.google.com/citations?user=EF_Zis4AAAAJ&hl=en"
                rel="noopener noreferrer">Google Scholar: Zijun Yu</a
            >
        </div>
    </body>
</html>
