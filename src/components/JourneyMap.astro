---

---

<figure class="zh-journey" aria-label="Cities I have called home">
    <svg
        viewBox="0 0 480 560"
        class="zh-journey__svg"
        role="img"
        aria-label="A map of the cities I have called home: Chefoo, Beijing, Montréal, and one more to come."
    >
        <defs>
            <linearGradient id="j-bg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.16"
                ></stop>
                <stop offset="100%" stop-color="var(--ink)" stop-opacity="0.06"
                ></stop>
            </linearGradient>
            <pattern
                id="j-dots"
                width="6"
                height="6"
                patternUnits="userSpaceOnUse"
            >
                <circle
                    cx="3"
                    cy="3"
                    r="0.5"
                    fill="var(--ink)"
                    fill-opacity="0.1"></circle>
            </pattern>
            <marker
                id="j-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="5.5"
                markerHeight="5.5"
                orient="auto-start-reverse"
            >
                <path
                    d="M 0 0 L 10 5 L 0 10 z"
                    fill="var(--ink)"
                    fill-opacity="0.65"></path>
            </marker>
        </defs>

        <rect width="480" height="560" fill="url(#j-bg)"></rect>
        <rect width="480" height="560" fill="url(#j-dots)"></rect>

        <!-- Dashed connector paths -->
        <g
            fill="none"
            stroke="var(--ink)"
            stroke-opacity="0.38"
            stroke-width="1.5"
            stroke-dasharray="5 5"
            stroke-linecap="round"
        >
            <path d="M 158 470 Q 240 500 300 420" marker-end="url(#j-arrow)"
            ></path>
            <path d="M 290 282 Q 248 232 215 218" marker-end="url(#j-arrow)"
            ></path>
            <path d="M 220 138 Q 295 100 348 102" marker-end="url(#j-arrow)"
            ></path>
        </g>

        <!-- Paper airplane on the trans-Pacific leg -->
        <g transform="translate(252 258) rotate(-144)">
            <path
                d="M 20 0 L -14 -11 L -6 0 L -14 11 Z"
                fill="var(--accent)"
                fill-opacity="0.88"></path>
            <path
                d="M 20 0 L -14 11 L -6 0 Z"
                fill="var(--ink)"
                fill-opacity="0.22"></path>
            <line
                x1="20"
                y1="0"
                x2="-6"
                y2="0"
                stroke="var(--ink)"
                stroke-opacity="0.55"
                stroke-width="0.9"></line>
            <path
                d="M 20 0 L -14 -11 L -6 0 L -14 11 Z"
                fill="none"
                stroke="var(--ink)"
                stroke-opacity="0.6"
                stroke-width="1"></path>
        </g>

        <!-- 1. Chefoo -->
        <g transform="translate(98, 458) scale(1.35)">
            <circle
                cx="-2"
                cy="-28"
                r="11"
                fill="var(--accent)"
                fill-opacity="0.75"></circle>
            <g
                fill="none"
                stroke="var(--ink)"
                stroke-opacity="0.55"
                stroke-width="1.2"
            >
                <path d="M -38 -8 q 10 -5 20 0 t 20 0 t 20 0"></path>
                <path d="M -38 2 q 10 -5 20 0 t 20 0 t 20 0"></path>
                <path d="M -32 12 q 10 -5 20 0 t 20 0" stroke-opacity="0.35"
                ></path>
            </g>
            <path
                d="M -44 22 Q -16 14 14 16 Q 38 18 48 26 L 48 32 L -44 32 Z"
                fill="var(--ink)"
                fill-opacity="0.55"></path>
            <text
                x="2"
                y="54"
                text-anchor="middle"
                font-size="14"
                font-family="var(--display)"
                font-style="italic"
                fill="var(--ink)"
                fill-opacity="0.95">Chefoo</text
            >
            <text
                x="2"
                y="68"
                text-anchor="middle"
                font-size="8"
                font-family="var(--mono)"
                letter-spacing="0.08em"
                fill="var(--ink)"
                fill-opacity="0.55">HOMETOWN</text
            >
        </g>

        <!-- 2. Beijing -->
        <g transform="translate(345, 362) scale(1.3)">
            <g fill="var(--ink)" fill-opacity="0.78">
                <rect x="-46" y="-30" width="14" height="50"></rect>
                <rect x="-28" y="-52" width="18" height="72"></rect>
                <rect x="-6" y="-72" width="16" height="92"></rect>
                <rect x="14" y="-44" width="14" height="64"></rect>
                <rect x="30" y="-22" width="12" height="42"></rect>
            </g>
            <line
                x1="2"
                y1="-72"
                x2="2"
                y2="-86"
                stroke="var(--ink)"
                stroke-opacity="0.78"
                stroke-width="1.4"></line>
            <rect
                x="-2"
                y="-58"
                width="3"
                height="3"
                fill="var(--accent)"
                fill-opacity="0.85"></rect>
            <rect
                x="4"
                y="-42"
                width="3"
                height="3"
                fill="var(--accent)"
                fill-opacity="0.65"></rect>
            <text
                x="-2"
                y="40"
                text-anchor="middle"
                font-size="14"
                font-family="var(--display)"
                font-style="italic"
                fill="var(--ink)"
                fill-opacity="0.95">Beijing</text
            >
            <text
                x="-2"
                y="56"
                text-anchor="middle"
                font-size="9"
                font-family="var(--mono)"
                letter-spacing="0.08em"
                fill="var(--ink)"
                fill-opacity="0.55">GREW UP</text
            >
        </g>

        <!-- 3. Montréal -->
        <g transform="translate(155, 175) scale(1.3)">
            <path
                d="M -50 10 L -20 -22 L 0 -8 L 18 -32 L 38 -6 L 52 10 Z"
                fill="var(--ink)"
                fill-opacity="0.45"></path>
            <path
                d="M -42 12 L -16 -38 L -4 -18 L 8 -44 L 28 -12 L 46 12 Z"
                fill="var(--ink)"
                fill-opacity="0.78"></path>
            <path
                d="M 4 -40 L 8 -44 L 14 -34 Z"
                fill="var(--bg)"
                fill-opacity="0.85"></path>
            <rect
                x="22"
                y="4"
                width="12"
                height="16"
                fill="var(--ink)"
                fill-opacity="0.6"></rect>
            <rect
                x="26"
                y="8"
                width="2"
                height="2"
                fill="var(--accent)"
                fill-opacity="0.85"></rect>
            <path
                d="M -54 22 Q -20 16 8 22 T 56 24"
                fill="none"
                stroke="var(--accent)"
                stroke-opacity="0.7"
                stroke-width="2.2"
                stroke-linecap="round"></path>
            <text
                x="0"
                y="46"
                text-anchor="middle"
                font-size="14"
                font-family="var(--display)"
                font-style="italic"
                fill="var(--ink)"
                fill-opacity="0.95">Montréal</text
            >
            <text
                x="0"
                y="62"
                text-anchor="middle"
                font-size="9"
                font-family="var(--mono)"
                letter-spacing="0.08em"
                fill="var(--ink)"
                fill-opacity="0.55">HOME</text
            >
        </g>

        <!-- 4. ? — the unknown next chapter -->
        <g transform="translate(390, 80) rotate(-4) scale(1.2)">
            <path
                d="M -33 -25 L -16 -30 L 4 -28 L 22 -30 L 35 -23 L 38 -8
               L 36 8 L 39 22 L 28 31 L 8 28 L -10 32 L -28 27
               L -35 16 L -33 0 L -38 -12 Z"
                fill="var(--ink)"
                fill-opacity="0.12"
                transform="translate(2 3)"></path>
            <path
                d="M -33 -25 L -16 -30 L 4 -28 L 22 -30 L 35 -23 L 38 -8
               L 36 8 L 39 22 L 28 31 L 8 28 L -10 32 L -28 27
               L -35 16 L -33 0 L -38 -12 Z"
                fill="var(--accent)"
                fill-opacity="0.22"
                stroke="var(--accent)"
                stroke-opacity="0.85"
                stroke-width="1.3"
                stroke-linejoin="round"></path>
            <g
                fill="none"
                stroke="var(--ink)"
                stroke-opacity="0.22"
                stroke-width="0.7"
            >
                <path d="M -32 -6 Q 0 -10 36 -2"></path>
                <path d="M -8 -29 Q -6 0 -4 30" stroke-opacity="0.16"></path>
            </g>
            <path
                d="M -24 20 q 8 -6 14 0 t 14 -4"
                fill="none"
                stroke="var(--accent)"
                stroke-opacity="0.65"
                stroke-width="1.1"
                stroke-dasharray="1.4 3"
                stroke-linecap="round"></path>
            <g
                stroke="var(--accent)"
                stroke-opacity="0.8"
                stroke-width="1.4"
                stroke-linecap="round"
            >
                <line x1="22" y1="14" x2="28" y2="20"></line>
                <line x1="28" y1="14" x2="22" y2="20"></line>
            </g>
            <text
                x="-2"
                y="8"
                text-anchor="middle"
                font-size="32"
                font-family="var(--display)"
                font-weight="600"
                font-style="italic"
                fill="var(--ink)"
                fill-opacity="0.85">?</text
            >
            <text
                x="0"
                y="54"
                text-anchor="middle"
                font-size="13"
                font-family="var(--display)"
                font-style="italic"
                fill="var(--ink)"
                fill-opacity="0.9"
                transform="rotate(4)">Where next?</text
            >
        </g>
    </svg>

    <figcaption class="zh-journey__cap">
        <span class="zh-eyebrow">Cities, in order</span>
        <span class="zh-journey__caption-text">
            Chefoo → Beijing → Montréal.
        </span>
    </figcaption>
</figure>
