                    </p>

                    <h2>What surprised me</h2>
                    <p>
                        <!-- Placeholder — power draw, noise, uptime observations -->
                        [Notes on power consumption, noise levels, and reliability to be added.]
                    </p>

                    <h2>Was it worth it</h2>
                    <p>
                        <!-- Placeholder — honest assessment -->
                        [Honest assessment of the tradeoffs to be added.]
                    </p>
                </div>

                <footer class="zh-post__foot">
                    <ul class="zh-post__tags">
                        {post.tags.map((t) => <li>{t}</li>)}
                    </ul>
                    <div class="zh-post__nav">
                        <!-- No adjacent posts yet -->
                    </div>
                </footer>
            </div>
        </article>
    </main>

    <footer class="zh-footer zh-shell zh-footer__bottom">
        <span>© 2026 Zijun Yu</span>
        <span>— last updated <time>May 2026</time></span>
    </footer>
</BaseLayout>
