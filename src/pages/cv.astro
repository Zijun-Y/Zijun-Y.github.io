---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.svelte";
---

<BaseLayout title="CV · Zijun Yu">
    <SiteHeader client:load />
    <main class="zh-main zh-shell zh-cv" id="top">
        <!-- Page title + download -->
        <div class="zh-cv__top">
            <h1 class="zh-cv__title">Curriculum Vitae</h1>
            <a
                href="/cv.pdf"
                class="zh-cv__download"
                target="_blank"
                rel="noopener noreferrer"
            >
                Download PDF
                <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    aria-hidden="true"
                    style="margin-left:6px;vertical-align:-1px;"
                >
                    <path
                        d="M12 3v12m0 0l-4-4m4 4l4-4M3 18h18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </a>
        </div>

        <p class="zh-cv__tagline">
            PhD student in Mathematics and Statistics developing
            distribution-free methods for uncertainty quantification and risk
            control, with a current focus on the reliability, evaluation, and
            safety of LLMs and autonomous agents. First-author work at ICML
            2026 and three manuscripts under review.
        </p>

        <!-- Education -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Education</h2>
            <div class="zh-cv__entries">
                <div class="zh-cv__entry">
                    <div class="zh-cv__entry-period">2025 – 2029 (exp.)</div>
                    <div class="zh-cv__entry-body">
                        <div class="zh-cv__entry-role">
                            Ph.D. in Mathematics and Statistics
                            <span class="zh-cv__entry-tag">Direct-entry</span>
                        </div>
                        <div class="zh-cv__entry-org">
                            McGill University, Montréal, QC
                        </div>
                        <div class="zh-cv__entry-detail">
                            Supervisors: Prof. Masoud Asgharian, Prof. Vahid
                            Partovi Nia
                        </div>
                        <div class="zh-cv__entry-detail">
                            Research: distribution-free uncertainty
                            quantification and risk control; reliability and
                            safety of LLMs and autonomous agents
                        </div>
                    </div>
                </div>
                <div class="zh-cv__entry">
                    <div class="zh-cv__entry-period">2016 – 2020</div>
                    <div class="zh-cv__entry-body">
                        <div class="zh-cv__entry-role">
                            B.Sc. Honours in Statistics and Computer Science
                        </div>
                        <div class="zh-cv__entry-org">
                            McGill University, Montréal, QC
                        </div>
                        <div class="zh-cv__entry-detail">
                            First-Class Honours Degree
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Awards -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Awards &amp; Scholarships</h2>
            <ul class="zh-cv__awards">
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >ISM Graduate Scholarship</span
                        >
                        <span class="zh-cv__award-org"
                            >Institut des sciences mathématiques</span
                        >
                    </span>
                    <span class="zh-cv__award-year">2026–2027</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name">ISM Travel Grant</span>
                        <span class="zh-cv__award-org"
                            >Institut des sciences mathématiques</span
                        >
                    </span>
                    <span class="zh-cv__award-year">2026</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >ISM Graduate Scholarship</span
                        >
                        <span class="zh-cv__award-org"
                            >Institut des sciences mathématiques</span
                        >
                    </span>
                    <span class="zh-cv__award-year">2025–2026</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >Graduate Excellence Award</span
                        >
                        <span class="zh-cv__award-org">McGill University</span>
                    </span>
                    <span class="zh-cv__award-year">2025–2029</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >First-Class Honours Degree</span
                        >
                        <span class="zh-cv__award-org">McGill University</span>
                    </span>
                    <span class="zh-cv__award-year">2020</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >Science Undergraduate Research Award (SURA)</span
                        >
                        <span class="zh-cv__award-org">McGill University</span>
                    </span>
                    <span class="zh-cv__award-year">2019</span>
                </li>
                <li>
                    <span class="zh-cv__award-text">
                        <span class="zh-cv__award-name"
                            >James McGill Scholarship</span
                        >
                        <span class="zh-cv__award-org">McGill University</span>
                    </span>
                    <span class="zh-cv__award-year">2016</span>
                </li>
            </ul>
        </section>

        <!-- Publications -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Publications</h2>
            <p class="zh-cv__footnote zh-cv__footnote--top">
                <sup>†</sup> Equal contribution.
            </p>

            <h3 class="zh-cv__subhead">Refereed</h3>
            <ol class="zh-cv__pubs">
                <li class="zh-cv__pub">
                    <span class="zh-cv__pub-authors">
                        Pengqi Liu<sup>†</sup>, <strong>Zijun Yu</strong><sup
                            >†</sup
                        >, Mouloud Belbahri, Arthur Charpentier, Masoud
                        Asgharian, Jesse C. Cresswell.
                    </span>
                    <span class="zh-cv__pub-title">
                        "Beyond Procedure: Substantive Fairness in Conformal
                        Prediction."
                    </span>
                    <span class="zh-cv__pub-venue">
                        <em
                            >International Conference on Machine Learning (ICML)</em
                        >, 2026.
                        <a
                            href="https://arxiv.org/abs/2602.16794"
                            target="_blank"
                            rel="noopener noreferrer">arXiv ↗</a
                        >
                    </span>
                </li>
            </ol>

            <h3 class="zh-cv__subhead">Under Review</h3>
            <ol class="zh-cv__pubs">
                <li class="zh-cv__pub">
                    <span class="zh-cv__pub-authors">
                        <strong>Zijun Yu</strong><sup>†</sup>, Yu Gu<sup
                            >†</sup
                        >, Vahid Partovi Nia, Masoud Asgharian.
                    </span>
                    <span class="zh-cv__pub-title">
                        "G-CARB: Graph-Localized Conformal Agent Risk Budgets
                        for Compositional Harm."
                    </span>
                    <span class="zh-cv__pub-venue">
                        <em>Under review</em>, 2026.
                    </span>
                </li>
                <li class="zh-cv__pub">
                    <span class="zh-cv__pub-authors">
                        Yu Gu<sup>†</sup>, <strong>Zijun Yu</strong><sup>†</sup
                        >, Vahid Partovi Nia, Masoud Asgharian.
                    </span>
                    <span class="zh-cv__pub-title">
                        "Pause and Reflect: Conformal Aggregation for
                        Chain-of-Thought Reasoning."
                    </span>
                    <span class="zh-cv__pub-venue">
                        <em>Under review</em>, 2026.
                        <a
                            href="https://arxiv.org/abs/2605.14098"
                            target="_blank"
                            rel="noopener noreferrer">arXiv ↗</a
                        >
                    </span>
                </li>
                <li class="zh-cv__pub">
                    <span class="zh-cv__pub-authors">
                        Yu Gu<sup>†</sup>, <strong>Zijun Yu</strong><sup>†</sup
                        >, Chi-Kuang Yeh, Xinyu Wang, Ziyang Song.
                    </span>
                    <span class="zh-cv__pub-title">
                        "Severity-Controlled Prediction Sets for Medication
                        Recommendation."
                    </span>
                    <span class="zh-cv__pub-venue">
                        <em>Under review</em>, 2026.
                    </span>
                </li>
            </ol>
        </section>

        <!-- Presentations -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Presentations</h2>
            <ol class="zh-cv__pubs">
                <li class="zh-cv__pub">
                    <span class="zh-cv__pub-title">
                        "Beyond Procedure: Substantive Fairness in Conformal
                        Prediction." Poster presentation.
                    </span>
                    <span class="zh-cv__pub-venue">
                        <em
                            >International Conference on Machine Learning (ICML)</em
                        >, Seoul, South Korea, 2026.
                    </span>
                </li>
            </ol>
        </section>

        <!-- Patents and Open-Source Software -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title"
                >Patents &amp; Open-Source Software</h2
            >
            <ul class="zh-cv__bullets">
                <li>
                    <strong>Patent application</strong> filed (Layer 6 AI, 2026),
                    related to methods in "Beyond Procedure: Substantive
                    Fairness in Conformal Prediction."
                </li>
                <li>
                    <strong>llm-in-the-loop-conformal-fairness</strong> —
                    open-source release of the evaluation and benchmarking
                    framework for the ICML 2026 paper.
                    <a
                        href="https://github.com/layer6ai-labs/llm-in-the-loop-conformal-fairness"
                        target="_blank"
                        rel="noopener noreferrer"
                        >github.com/layer6ai-labs/llm-in-the-loop-conformal-fairness
                        ↗</a
                    >
                </li>
            </ul>
        </section>

        <!-- Work Experience -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Work Experience</h2>
            <div class="zh-cv__entries">
                <div class="zh-cv__entry">
                    <div class="zh-cv__entry-period">2025 – 2026</div>
                    <div class="zh-cv__entry-body">
                        <div class="zh-cv__entry-role">
                            Student Researcher <span class="zh-cv__entry-tag"
                                >Mitacs Internship</span
                            >
                        </div>
                        <div class="zh-cv__entry-org">Layer 6 AI, Toronto</div>
                        <ul class="zh-cv__bullets">
                            <li>
                                Conducted research on substantive fairness in
                                conformal prediction, leading to "Beyond
                                Procedure: Substantive Fairness in Conformal
                                Prediction" (ICML 2026) and a filed patent
                                application.
                            </li>
                            <li>
                                Designed and architected a modular codebase
                                supporting large-scale experiment pipelines,
                                enabling reproducible benchmarking across
                                multiple fairness criteria, datasets, and model
                                families; released open source.
                            </li>
                            <li>
                                Collaborated with research scientists on
                                theoretical analysis and empirical validation.
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="zh-cv__entry">
                    <div class="zh-cv__entry-period">2020 – 2024</div>
                    <div class="zh-cv__entry-body">
                        <div class="zh-cv__entry-role">Software Developer</div>
                        <div class="zh-cv__entry-org">
                            OneDesk Inc., Montréal
                        </div>
                        <ul class="zh-cv__bullets">
                            <li>
                                Built a Retrieval-Augmented Generation chatbot
                                pipeline (web crawler, vector database, LLM
                                APIs) and added data analysis and
                                visualization capabilities to the core
                                product.
                            </li>
                            <li>
                                Diagnosed and resolved memory leaks, race
                                conditions, and data-consistency failures
                                across frontend and backend systems; applied
                                time-series analysis to production logs to
                                audit system performance and identify
                                regressions.
                            </li>
                            <li>
                                Led and mentored a team of junior developers
                                across multiple concurrent projects.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technical Skills -->
        <section class="zh-cv__section">
            <h2 class="zh-cv__section-title">Technical Skills</h2>
            <div class="zh-cv__skills">
                <div class="zh-cv__skill-row">
                    <span class="zh-cv__skill-label">ML</span>
                    <span class="zh-cv__skill-value"
                        >PyTorch, Hugging Face Transformers, vLLM,
                        llama.cpp</span
                    >
                </div>
                <div class="zh-cv__skill-row">
                    <span class="zh-cv__skill-label">Languages</span>
                    <span class="zh-cv__skill-value"
                        >Python, R, Java, TypeScript, SQL</span
                    >
                </div>
                <div class="zh-cv__skill-row">
                    <span class="zh-cv__skill-label">Infrastructure</span>
                    <span class="zh-cv__skill-value"
                        >Docker, PostgreSQL, Redis, Git, Proxmox VE</span
                    >
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .zh-cv {
        padding-top: calc(64px + clamp(48px, 8vh, 96px));
        padding-bottom: clamp(64px, 10vh, 120px);
        max-width: 800px;
    }

    .zh-cv__top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding-bottom: clamp(36px, 6vh, 56px);
        border-bottom: 0.5px solid var(--rule);
        margin-bottom: clamp(20px, 3vh, 28px);
    }
    .zh-cv__title {
        font-family: var(--display);
        font-weight: var(--display-weight);
        font-size: clamp(36px, 5vw, 64px);
        letter-spacing: var(--display-tracking);
        line-height: 1.05;
        margin: 0;
    }
    .zh-cv__download {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        border: 0.5px solid var(--rule);
        padding: 8px 16px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        transition:
            background 0.2s,
            color 0.2s,
            border-color 0.2s;
        white-space: nowrap;
    }
    .zh-cv__download:hover {
        background: var(--ink);
        color: var(--bg);
        border-color: var(--ink);
    }

    .zh-cv__tagline {
        font-family: var(--display);
        font-size: clamp(16px, 1.6vw, 19px);
        line-height: 1.55;
        color: var(--muted);
        max-width: 62ch;
        margin: 0 0 clamp(36px, 6vh, 56px);
        text-wrap: pretty;
    }

    .zh-cv__subhead {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 22px 0 4px;
    }
    .zh-cv__subhead:first-of-type {
        margin-top: 0;
    }

    .zh-cv__section {
        margin-bottom: clamp(36px, 6vh, 56px);
    }
    .zh-cv__section-title {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 20px;
        padding-bottom: 10px;
        border-bottom: 0.5px solid var(--rule);
    }

    /* Entries (education, work) */
    .zh-cv__entries {
        display: flex;
        flex-direction: column;
        gap: 28px;
    }
    .zh-cv__entry {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 24px;
    }
    .zh-cv__entry-period {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--muted);
        letter-spacing: 0.04em;
        padding-top: 3px;
    }
    .zh-cv__entry-role {
        font-family: var(--body);
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .zh-cv__entry-tag {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent);
        background: rgba(var(--accent-rgb), 0.12);
        padding: 3px 9px;
        border-radius: 999px;
        font-weight: 400;
    }
    .zh-cv__entry-org {
        font-size: 14px;
        color: var(--muted);
        margin-top: 3px;
    }
    .zh-cv__entry-detail {
        font-size: 13px;
        color: var(--muted);
        font-style: italic;
        margin-top: 2px;
    }
    .zh-cv__bullets {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .zh-cv__bullets li {
        font-size: 14px;
        color: var(--ink);
        line-height: 1.6;
        padding-left: 18px;
        position: relative;
    }
    .zh-cv__bullets li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    /* Awards */
    .zh-cv__awards {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }
    .zh-cv__awards li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        padding: 11px 0;
        border-bottom: 0.5px solid var(--rule);
        font-size: 14px;
    }
    .zh-cv__awards li:first-child {
        border-top: 0.5px solid var(--rule);
    }
    .zh-cv__award-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .zh-cv__award-name {
        color: var(--ink);
    }
    .zh-cv__award-org {
        font-size: 12px;
        color: var(--muted);
        font-style: italic;
    }
    .zh-cv__award-year {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--muted);
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    /* Publications */
    .zh-cv__pubs {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        counter-reset: pub-counter;
    }
    .zh-cv__pub {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 18px 0 18px 32px;
        border-bottom: 0.5px solid var(--rule);
        position: relative;
        counter-increment: pub-counter;
    }
    .zh-cv__pub:first-child {
        border-top: 0.5px solid var(--rule);
    }
    .zh-cv__pub::before {
        content: counter(pub-counter, decimal-leading-zero);
        position: absolute;
        left: 0;
        top: 20px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        letter-spacing: 0.04em;
    }
    .zh-cv__pub-authors {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.5;
    }
    .zh-cv__pub-authors strong {
        color: var(--ink);
        font-weight: 600;
        border-bottom: 1px solid var(--accent);
    }
    .zh-cv__pub-authors sup {
        color: var(--accent);
        font-size: 0.75em;
    }
    .zh-cv__pub-title {
        font-family: var(--display);
        font-size: clamp(15px, 1.4vw, 18px);
        letter-spacing: var(--display-tracking);
        color: var(--ink);
        line-height: 1.3;
    }
    .zh-cv__pub-venue {
        font-size: 13px;
        color: var(--muted);
    }
    .zh-cv__pub-venue a {
        color: var(--accent);
        text-decoration: none;
        margin-left: 6px;
    }
    .zh-cv__pub-venue a:hover {
        text-decoration: underline;
    }
    .zh-cv__footnote {
        margin: 12px 0 0;
        font-size: 12px;
        color: var(--muted);
        font-style: italic;
    }
    .zh-cv__footnote--top {
        margin: 0 0 4px;
    }

    /* Skills */
    .zh-cv__skills {
        display: flex;
        flex-direction: column;
    }
    .zh-cv__skill-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 24px;
        padding: 10px 0;
        border-bottom: 0.5px solid var(--rule);
        font-size: 14px;
    }
    .zh-cv__skill-row:first-child {
        border-top: 0.5px solid var(--rule);
    }
    .zh-cv__skill-label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        padding-top: 2px;
    }
    .zh-cv__skill-value {
        color: var(--ink);
    }

    @media (max-width: 600px) {
        .zh-cv__entry {
            grid-template-columns: 1fr;
            gap: 6px;
        }
        .zh-cv__skill-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }
        .zh-cv__top {
            flex-direction: column;
            gap: 16px;
        }
    }
</style>
