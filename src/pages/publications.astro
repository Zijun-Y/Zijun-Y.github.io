---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.svelte';
import PublicationsSection from '@/components/PublicationsSection.svelte';
import { publications } from '@/content/publications';
---

<BaseLayout title="Publications · Zijun Yu">
  <SiteHeader client:load />
  <main class="zh-main" id="top">
    <div class="zh-shell" style="padding-top: calc(64px + clamp(32px, 6vh, 64px)); padding-bottom: clamp(16px, 3vh, 32px);">
      <h1 style="font-family: var(--display); font-size: clamp(36px, 5vw, 64px); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); line-height: 1.05; margin: 0;">
        Publications
      </h1>
    </div>
    <PublicationsSection {publications} showHeading={false} client:load />
  </main>
</BaseLayout>
