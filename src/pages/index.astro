---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.svelte";
import PublicationsSection from "@/components/PublicationsSection.svelte";
import { featuredPublications as publications } from "@/content/publications";
---

<BaseLayout title="Zijun Yu — PhD student, McGill">
    <SiteHeader client:load />

    <main class="zh-main" id="top">
        <!-- ── Hero ─────────────────────────────────────────────── -->
        <section class="zh-hero zh-shell">
            <div class="zh-hero__meta">
                <span class="zh-meta-loc">
                    <span class="zh-meta-loc-dash"></span>
                    Montréal, QC
                </span>
            </div>

            <h1 class="zh-hero__name">
                <span class="zh-hero__line">Zijun</span>
                <span class="zh-hero__line zh-hero__line--italic">Yu</span>
            </h1>

            <p class="zh-hero__bio">
                I'm a PhD student in Mathematics &amp; Statistics at <em
                    >McGill University</em
                >. I study how AI systems can know when they might be wrong
                — statistical methods, mostly conformal prediction, whose
                guarantees hold without assumptions about the model or the
                data. Lately that means language models: when a reasoning
                model should abstain, when an agent should be stopped, and how
                to keep those guarantees affordable.
            </p>

            <p class="zh-hero__note">
                Supervised by Masoud Asgharian and Vahid Partovi Nia;
                previously a research intern at Layer&nbsp;6&nbsp;AI. Before
                the PhD, I spent four years as a software developer at
                OneDesk, building a retrieval-augmented LLM chatbot and
                chasing memory leaks and race conditions in production —
                habits I now bring to research code that others can rerun.
            </p>

            <ul class="zh-tags" aria-label="Research interests">
                <li class="zh-tag"><span>Conformal Prediction</span></li>
                <li class="zh-tag"><span>LLM &amp; Agent Safety</span></li>
                <li class="zh-tag"><span>Risk Control</span></li>
            </ul>

            <a
                href="#publications"
                class="zh-scroll-cue"
                aria-label="Scroll to publications"
            >
                <span class="zh-scroll-cue__label">Selected publications</span>
                <span class="zh-scroll-cue__line"></span>
            </a>
        </section>

        <!-- ── Publications ──────────────────────────────────────── -->
        <PublicationsSection {publications} client:visible />
    </main>

    <!-- ── Footer ────────────────────────────────────────────── -->
    <footer class="zh-footer zh-shell zh-footer__bottom">
        <span>© 2026 Zijun Yu</span>
        <span>— last updated <time>October 2026</time></span>
    </footer>
</BaseLayout>

<script>
    // Smooth-scroll in-page anchors (offset for fixed header)
    document.addEventListener("click", (e) => {
        const a = (e.target as Element).closest('a[href^="#"]');
        if (!a) return;
        const id = a.getAttribute("href")!.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        const top = el.getBoundingClientRect().top + window.scrollY - 24;
        window.scrollTo({ top, behavior: "smooth" });
    });
</script>
