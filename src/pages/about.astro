---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.svelte';
---

<BaseLayout title="About · Zijun Yu">
  <SiteHeader client:load />
  <main class="zh-main zh-shell" style="padding-top: calc(64px + clamp(48px, 9vh, 96px));">
    <h1 style="font-family: var(--display); font-size: clamp(36px, 5vw, 64px); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); margin: 0;">
      About
    </h1>
    <p style="margin-top: 24px; color: var(--muted); font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;">
      Content coming soon.
    </p>
  </main>
</BaseLayout>
